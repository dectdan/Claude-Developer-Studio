<Project>
  <!--
    The one ClaudeDevStudio version for every C# project in this repository
    (CLI, TrayApp, Dashboard, VS Bridge). Change it here only.
    The other files that must carry the same number (package.json, manifest.json,
    setup.nsi, the VSIX manifest) are checked by
    tools\check-versions.ps1.
  -->
  <PropertyGroup>
    <Version>1.3.0</Version>
  </PropertyGroup>
</Project>
